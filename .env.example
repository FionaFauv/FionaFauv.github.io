# Copie ce fichier en .env pour le développement local, puis remplis les valeurs.
# .env est ignoré par git : ne committe JAMAIS de vraie clé.
# En production, ces valeurs sont des secrets GitHub (Settings > Secrets and variables > Actions).
# Toutes facultatives : sans elles, le site se construit avec les données provisoires.

# YouTube Data API v3 (console.cloud.google.com). L'ID de chaîne (UC...) ajoute les vidéos publiques ;
# les non répertoriées passent par une playlist ou le catalogue de src/data/videos.ts.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Twitch Helix API (dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam Web API (steamcommunity.com/dev/apikey) et SteamID64 du profil (17 chiffres, 7656…).
# Le profil doit avoir « Détails des jeux » en public. Seuls les jeux avec steamAppId sont enrichis.
STEAM_API_KEY=
STEAM_ID=

# Discord : ID du serveur (widget à activer) et lien d'invitation
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=
