---
/**
 * Petite pousse façon Pikmin : tête ronde colorée, tige, et au bout une feuille,
 * un bourgeon ou une fleur. Sert de décor et d'indicateur d'avancement (sproutStage).
 */
import type { SproutColor, SproutStage } from '../lib/sprout';

interface Props {
  stage?: SproutStage;
  color?: SproutColor;
  /** Largeur en px (la hauteur vaut 1,5 fois la largeur). */
  size?: number;
  class?: string;
  /** Texte pour les lecteurs d'écran ; sans lui la pousse est décorative. */
  label?: string;
}

const { stage = 'leaf', color = 'red', size = 32, class: className, label } = Astro.props;
const petals: [number, number][] = [
  [0, -5],
  [5, -1],
  [3, 5],
  [-3, 5],
  [-5, -1],
];
---

<svg
  width={size}
  height={size * 1.5}
  viewBox="0 0 40 60"
  class:list={['shrink-0', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path d="M20 44 C 20 32, 22 22, 20 12" fill="none" style="stroke:var(--outline)" stroke-width="2.5" stroke-linecap="round"></path>
  {stage === 'leaf' && <path d="M20 12 C 12 8, 12 0, 20 2 C 28 0, 28 8, 20 12 Z" style="fill:var(--grass);stroke:var(--outline)" stroke-width="2"></path>}
  {stage === 'bud' && <path d="M20 13 C 14 10, 15 2, 20 1 C 25 2, 26 10, 20 13 Z" style="fill:var(--pink);stroke:var(--outline)" stroke-width="2"></path>}
  {
    stage === 'flower' && (
      <g>
        {petals.map(([dx, dy]) => (
          <circle cx={20 + dx} cy={7 + dy} r="4" style="fill:#ffffff;stroke:var(--outline)" stroke-width="2" />
        ))}
        <circle cx="20" cy="7" r="3" style="fill:var(--yellow);stroke:var(--outline)" stroke-width="2" />
      </g>
    )
  }
  <ellipse cx="20" cy="48" rx="11" ry="10" style={`fill:var(--${color});stroke:var(--outline)`} stroke-width="2.5"></ellipse>
  <circle cx="16" cy="47" r="2.2" fill="#ffffff"></circle>
  <circle cx="24" cy="47" r="2.2" fill="#ffffff"></circle>
  <circle cx="16.5" cy="47.5" r="1" fill="#22301c"></circle>
  <circle cx="24.5" cy="47.5" r="1" fill="#22301c"></circle>
</svg>
