---
/**
 * En-tête du site : ciel, grandes feuilles, titre et boutons des pages.
 * Sur mobile, les boutons se replient derrière le bouton menu (script dans BaseLayout).
 */
import { NAV, SITE } from '../config/site';
import Icon from './Icon.astro';
import Sprout from './Sprout.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const leafVeins = 'M10 55 H 190 M60 55 L 90 25 M60 55 L 90 85 M110 55 L 140 28 M110 55 L 140 82';
---

<header class="relative overflow-hidden border-b-[3px] border-outline bg-sky">
  <!-- Décor : feuilles, fleur, rosée -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <svg class="absolute -bottom-10 -left-20 w-[240px] -rotate-12 lg:-bottom-16 lg:w-[420px]" viewBox="0 0 200 110">
      <path d="M4 55 C 50 -10, 150 -10, 196 55 C 150 120, 50 120, 4 55 Z" style="fill:var(--leaf);stroke:var(--outline)" stroke-width="4"></path>
      <path d={leafVeins} style="stroke:var(--moss)" stroke-width="4" stroke-linecap="round" fill="none"></path>
    </svg>
    <svg class="absolute -right-24 -bottom-12 w-[260px] rotate-[14deg] lg:-bottom-20 lg:w-[460px]" viewBox="0 0 200 110">
      <path d="M4 55 C 50 -10, 150 -10, 196 55 C 150 120, 50 120, 4 55 Z" style="fill:var(--grass);stroke:var(--outline)" stroke-width="4"></path>
      <path d={leafVeins} style="stroke:var(--moss)" stroke-width="4" stroke-linecap="round" fill="none"></path>
    </svg>
    <svg class="absolute top-6 right-[12%] hidden w-[90px] lg:block" viewBox="0 0 90 90">
      {
        [0, 60, 120, 180, 240, 300].map((a) => (
          <ellipse cx="45" cy="22" rx="12" ry="20" style="fill:var(--yellow);stroke:var(--outline)" stroke-width="3" transform={`rotate(${a} 45 45)`} />
        ))
      }
      <circle cx="45" cy="45" r="13" style="fill:var(--soil);stroke:var(--outline)" stroke-width="3"></circle>
    </svg>
    {
      [
        ['left-[18%] top-10', 40],
        ['right-[26%] top-24', 28],
        ['left-[8%] top-28', 24],
      ].map(([pos, s]) => (
        <svg class:list={['absolute hidden lg:block', pos]} width={s} height={s} viewBox="0 0 40 40">
          <circle cx="20" cy="20" r="17" style="fill:var(--dew);stroke:var(--outline)" stroke-width="3" />
          <path d="M11 16 a10 10 0 0 1 8 -7" stroke="#ffffff" stroke-width="4" stroke-linecap="round" fill="none" />
        </svg>
      ))
    }
  </div>

  <div class="relative mx-auto flex max-w-[1200px] flex-col gap-4 px-4 pt-[calc(16px+env(safe-area-inset-top,0px))] pb-6 lg:items-center lg:px-10 lg:pt-10 lg:pb-12">
    <div class="flex items-start gap-3 lg:flex-col lg:items-center">
      <a href="/" class="mr-auto flex items-end gap-2 no-underline lg:mr-0 lg:gap-3">
        <Sprout stage="flower" color="red" size={30} class="lg:hidden" />
        <Sprout stage="flower" color="red" size={50} class="hidden lg:block" />
        <span
          class="font-display text-[46px] leading-[.9] font-extrabold text-white [text-shadow:3px_3px_0_var(--outline),-2px_-2px_0_var(--outline),2px_-2px_0_var(--outline),-2px_2px_0_var(--outline)] lg:text-[92px] lg:[text-shadow:4px_4px_0_var(--outline),-2px_-2px_0_var(--outline),2px_-2px_0_var(--outline),-2px_2px_0_var(--outline)]"
        >
          {SITE.name}
        </span>
        <Sprout stage="bud" color="blue" size={50} class="hidden lg:block" />
      </a>
      <div class="flex items-center gap-2 lg:absolute lg:top-6 lg:right-10">
        <ThemeToggle />
        <button
          type="button"
          id="menu-toggle"
          class="grid size-11 cursor-pointer place-items-center rounded-full border-[3px] border-outline bg-accent text-accent-ink shadow-[0_4px_0_var(--outline)] lg:hidden"
          aria-label="Ouvrir le menu"
          aria-controls="site-nav"
          aria-expanded="false"
        >
          <Icon name="menu" />
        </button>
      </div>
    </div>
    <p class="font-display text-lg leading-snug font-bold text-ink lg:text-2xl">{SITE.tagline}</p>

    <nav
      id="site-nav"
      class="hidden flex-col gap-2.5 data-[open=true]:flex lg:mt-2 lg:flex lg:flex-row lg:flex-wrap lg:justify-center lg:gap-3"
      aria-label="Pages"
    >
      {
        NAV.map((item) => (
          <a href={item.href} class="btn justify-start lg:justify-center" aria-current={isActive(item.href) ? 'page' : undefined}>
            <Icon name={item.icon} />
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
