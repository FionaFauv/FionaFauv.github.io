---
import { SOCIALS } from '../config/site';
import type { DiscordSnapshot } from '../data/placeholders';
import Icon from './Icon.astro';

interface Props {
  data: DiscordSnapshot;
  /** Version courte pour la colonne de l'accueil. */
  compact?: boolean;
}

const { data, compact = false } = Astro.props;
const inVoice = data.voiceChannels.reduce((n, c) => n + c.members.length, 0);
const busiest = data.voiceChannels.find((c) => c.members.length > 0);
const invite = SOCIALS.find((s) => s.id === 'discord')?.href;
const statusColor = { online: 'after:bg-online', idle: 'after:bg-st-cent', dnd: 'after:bg-live' } as const;
---

{
  compact ? (
    <div class="grid gap-2.5">
      <div class="flex gap-5">
        <div class="grid">
          <b class="font-mono text-[22px] leading-tight font-medium tabular-nums">{data.onlineCount}</b>
          <span class="text-[13px] text-muted">en ligne</span>
        </div>
        <div class="grid">
          <b class="font-mono text-[22px] leading-tight font-medium tabular-nums">{inVoice}</b>
          <span class="text-[13px] text-muted">en vocal</span>
        </div>
      </div>
      {busiest && (
        <p class="flex items-center gap-2 text-sm">
          <Icon name="speaker" class="size-4 text-muted" />
          {busiest.name} : {busiest.members.join(', ')}
        </p>
      )}
    </div>
  ) : (
    <div class="max-w-[720px] overflow-hidden rounded-2xl border border-line bg-surface">
      <div class="flex items-center gap-3.5 border-b border-line p-[18px]">
        <span class="grid size-[52px] shrink-0 place-items-center rounded-2xl bg-discord text-white">
          <Icon name="discord" class="size-7" />
        </span>
        <div class="min-w-0">
          <h2 class="text-[22px] font-extrabold">{data.serverName}</h2>
          <p class="mt-1 flex flex-wrap gap-x-3.5 gap-y-1 text-sm text-muted">
            <span class="inline-flex items-center gap-1.5">
              <span class="size-[9px] rounded-full bg-online" aria-hidden="true" />
              {data.onlineCount} en ligne
            </span>
            {data.memberCount !== undefined && <span>{data.memberCount} membres</span>}
            <span class="kicker self-center text-[11px]">données d'exemple</span>
          </p>
        </div>
      </div>
      <div class="grid gap-[18px] p-[18px]">
        {data.voiceChannels.map((c) => (
          <div class="grid gap-2">
            <div class="flex items-center gap-2 text-[15px] font-semibold">
              <Icon name="speaker" class="size-4 text-muted" />
              {c.name}
            </div>
            <div class="flex flex-wrap gap-x-4 gap-y-2 pl-6 text-sm">
              {c.members.length ? c.members.map((m) => <span>{m}</span>) : <span class="text-muted">Personne pour l'instant</span>}
            </div>
          </div>
        ))}
        <div class="grid gap-2">
          <div class="text-[15px] font-semibold">En ligne</div>
          <ul class="flex flex-wrap gap-x-4 gap-y-2 pl-6">
            {data.onlineMembers.map((m) => (
              <li class="inline-flex items-center gap-2 text-sm">
                <span
                  class:list={[
                    'relative size-[26px] shrink-0 rounded-full bg-gradient-to-br from-thumb-b to-discord',
                    'after:absolute after:-right-px after:-bottom-px after:size-[9px] after:rounded-full after:border-2 after:border-surface',
                    statusColor[m.status],
                  ]}
                  aria-hidden="true"
                />
                {m.name}
                {m.activity && <small class="text-muted">· {m.activity}</small>}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-[color-mix(in_srgb,var(--discord)_6%,var(--surface))] px-[18px] py-3.5">
        <span class="text-[13px] text-muted">Accès sur invitation uniquement.</span>
        {invite && (
          <a
            href={invite}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-xl bg-discord px-4 py-3 text-[15px] leading-none font-semibold text-white no-underline hover:opacity-90"
          >
            Ouvrir dans Discord
          </a>
        )}
      </div>
    </div>
  )
}
