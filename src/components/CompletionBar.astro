---
interface Props {
  unlocked: number;
  total: number;
  /** Affiche le compteur « 38/63 · 60 % » au-dessus de la barre. */
  showCount?: boolean;
  size?: 'sm' | 'md';
}

const { unlocked, total, showCount = true, size = 'md' } = Astro.props;
const pct = Math.round((unlocked / total) * 100);
const full = pct === 100;
---

<div class="grid gap-1.5">
  {
    showCount && (
      <span class="text-sm leading-none font-bold text-muted tabular-nums">
        {unlocked}/{total} · {pct} %
      </span>
    )
  }
  <div
    class:list={['overflow-hidden rounded-full border-outline bg-track', size === 'sm' ? 'h-2.5 border-2' : 'h-4 border-[3px]']}
    role="img"
    aria-label={`${pct} % des succès débloqués`}
  >
    <div class:list={['h-full', full ? 'bg-yellow' : 'bg-grass']} style={`width:${pct}%`}></div>
  </div>
</div>
