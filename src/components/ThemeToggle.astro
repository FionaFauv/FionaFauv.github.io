---
import Icon from './Icon.astro';
---

<!-- L'icône affichée dépend du thème actif (voir global.css). Le script est dans BaseLayout. -->
<button
  type="button"
  class="theme-toggle grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border-[3px] border-outline bg-surface text-ink shadow-[0_4px_0_var(--outline)] hover:bg-accent-soft"
  aria-label="Basculer entre thème clair et sombre"
>
  <Icon name="moon" class="theme-icon-moon size-5" />
  <Icon name="sun" class="theme-icon-sun size-5" />
</button>
