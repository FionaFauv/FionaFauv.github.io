---
import Icon from './Icon.astro';
---

<!-- L'icône affichée dépend du thème actif (voir global.css). Le script est dans BaseLayout. -->
<button
  type="button"
  class="theme-toggle grid size-9 shrink-0 cursor-pointer place-items-center rounded-full border border-line bg-surface text-ink hover:border-accent"
  aria-label="Basculer entre thème clair et sombre"
>
  <Icon name="moon" class="theme-icon-moon size-[17px]" />
  <Icon name="sun" class="theme-icon-sun size-[17px]" />
</button>
