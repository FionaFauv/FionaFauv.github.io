---
import { formatRating, type Game } from '../lib/games';
import GameCover from './GameCover.astro';

interface Props {
  games: Game[];
  /** Version courte pour les widgets : rang, nom et note seulement. */
  compact?: boolean;
}

const { games, compact = false } = Astro.props;
// Pastille du rang : or pour le 1er, puis blanc, puis caillou.
const medal = ['bg-yellow text-on-light', 'bg-white text-on-light', 'bg-[var(--pebble)] text-on-light'];
---

<ol class="grid">
  {
    games.map((g, i) => (
      <li
        class:list={[
          'grid items-center border-b-2 border-dashed border-line last:border-b-0',
          compact ? 'grid-cols-[40px_minmax(0,1fr)_auto] gap-3 py-2.5' : 'grid-cols-[48px_56px_minmax(0,1fr)_auto] gap-4 py-4',
        ]}
      >
        <span
          class:list={[
            'grid place-items-center rounded-full border-[3px] border-outline font-display leading-none font-extrabold tabular-nums',
            compact ? 'size-10 text-xl' : 'size-12 text-2xl',
            medal[i] ?? 'bg-surface text-ink',
          ]}
        >
          {g.data.topRank}
        </span>
        {!compact && <GameCover game={g} class="w-14" />}
        <div class="min-w-0">
          <h3 class:list={['font-bold', compact ? 'text-xl' : 'text-[22px]']}>
            <a href={`/jeux/${g.id}/`} class="text-ink no-underline hover:text-accent">
              {g.data.name}
            </a>
          </h3>
          {!compact && g.data.review && <p class="mt-0.5 line-clamp-2 text-[15px] text-muted">{g.data.review}</p>}
        </div>
        <span class="leading-none font-extrabold whitespace-nowrap tabular-nums">{formatRating(g.data.rating)}/10</span>
      </li>
    ))
  }
</ol>
