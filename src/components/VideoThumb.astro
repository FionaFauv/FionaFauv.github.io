---
interface Props {
  src?: string;
  alt: string;
  duration?: string;
  loading?: 'lazy' | 'eager';
}

// Miniature 16/9 d'une vidéo ou d'une rediffusion, avec la durée en bas à droite.
const { src, alt, duration, loading = 'lazy' } = Astro.props;
---

<div class="placeholder-art relative aspect-video overflow-hidden rounded-[10px]">
  {
    src && (
      <img
        src={src}
        alt={alt}
        class="absolute inset-0 size-full object-cover"
        loading={loading}
        decoding="async"
        width="640"
        height="360"
        onerror="this.remove()"
      />
    )
  }
  {
    duration && (
      <span class="absolute right-1.5 bottom-1.5 rounded-[5px] bg-black/80 px-1.5 py-1 font-mono text-[11px] leading-none text-white">
        {duration}
      </span>
    )
  }
</div>
