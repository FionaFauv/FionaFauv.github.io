---
import { STATUS, type GameStatus } from '../lib/games';

interface Props {
  status: GameStatus;
}

const { status } = Astro.props;
const { label, color } = STATUS[status];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border-2 border-current bg-surface px-2.5 py-[5px] text-xs leading-none font-extrabold whitespace-nowrap',
    color,
  ]}
>
  <span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>
  {label}
</span>
