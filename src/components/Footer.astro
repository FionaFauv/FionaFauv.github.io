---
import { SITE, SOCIALS } from '../config/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-x-5 gap-y-3 px-4 pt-6 pb-[calc(24px+env(safe-area-inset-bottom,0px))] lg:px-10"
  >
    <ul class="flex flex-wrap gap-1.5" aria-label="Réseaux sociaux">
      {
        SOCIALS.filter((s) => s.id !== 'steam').map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1.5 text-sm font-medium no-underline hover:border-accent hover:text-accent"
            >
              <Icon name={s.id} class="size-4" />
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="text-[13px] text-muted">© {year} {SITE.name}</p>
  </div>
</footer>
