---
import { SITE, SOCIALS } from '../config/site';
import Icon from './Icon.astro';
import Sprout from './Sprout.astro';

const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t-[3px] border-outline bg-soil text-on-soil">
  <div
    class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-6 gap-y-4 px-4 pt-7 pb-[calc(28px+env(safe-area-inset-bottom,0px))] lg:px-10"
  >
    <div class="flex items-end gap-2">
      <Sprout stage="leaf" color="red" size={24} />
      <Sprout stage="bud" color="yellow" size={24} />
      <Sprout stage="flower" color="blue" size={24} />
      <p class="ml-2 font-display text-lg font-bold">© {year} {SITE.name}</p>
    </div>
    <ul class="flex flex-wrap gap-2" aria-label="Réseaux sociaux">
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" class="chip no-underline hover:bg-accent-soft">
              <Icon name={s.id} class="size-4" />
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
