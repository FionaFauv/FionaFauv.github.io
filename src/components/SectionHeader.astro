---
interface Props {
  title: string;
  /** Lien « voir plus » à droite. */
  href?: string;
  linkLabel?: string;
  /** Petit texte à droite (source des données, compteur…). */
  note?: string;
  id?: string;
}

const { title, href, linkLabel = 'Tout voir', note, id } = Astro.props;
---

<div class="mb-3 flex items-baseline justify-between gap-3 border-b-[3px] border-dashed border-line pb-3" id={id}>
  <h2 class="text-[28px] font-extrabold">{title}</h2>
  {href && <a href={href} class="font-bold text-accent no-underline hover:underline">{linkLabel}</a>}
  {!href && note && <span class="text-sm font-bold text-muted">{note}</span>}
</div>
