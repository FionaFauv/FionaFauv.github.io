  home: { stroke: true, body: '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>' },
  video: { stroke: true, body: '<rect x="2" y="5" width="20" height="14" rx="3"/><path d="M10 9l5 3-5 3z" fill="currentColor"/>' },
  stream: { stroke: true, body: '<circle cx="12" cy="12" r="2"/><path d="M16.2 7.8a6 6 0 0 1 0 8.4M7.8 16.2a6 6 0 0 1 0-8.4M19 5a10 10 0 0 1 0 14M5 19A10 10 0 0 1 5 5"/>' },
  gamepad: { stroke: true, body: '<path d="M6 9h4M8 7v4M15 10h.01M18 8h.01"/><path d="M7 4h10a5 5 0 0 1 5 5v5a3 3 0 0 1-5.4 1.8L15 14H9l-1.6 1.8A3 3 0 0 1 2 14V9a5 5 0 0 1 5-5z"/>' },
  chat: { stroke: true, body: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l.9-5.4A8 8 0 1 1 21 12z"/>' },
  link: { stroke: true, body: '<path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>' },
  sun: { stroke: true, body: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>' },
  moon: { stroke: true, body: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>' },
  menu: { stroke: true, body: '<path d="M4 7h16M4 12h16M4 17h16"/>' },
  close: { stroke: true, body: '<path d="M6 6l12 12M18 6L6 18"/>' },
  speaker: { stroke: true, body: '<path d="M11 5 6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/>' },
  sync: { stroke: true, body: '<path d="M21 12a9 9 0 0 1-15.5 6.3M3 12A9 9 0 0 1 18.5 5.7M18 2v4h-4M6 22v-4h4"/>' },
  arrow: { stroke: true, body: '<path d="M5 12h14M13 6l6 6-6 6"/>' },
  youtube: { stroke: false, body: '<path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.7 15.1V8.9L15.5 12Z"/>' },
  twitch: { stroke: false, body: '<path d="M4.3 2 3 5.4v14h4.7V22h2.7l2.6-2.6h3.8L22 14.2V2Zm16 11.4-3 3h-4.7L10 19v-2.6H6V3.8h14.3ZM17.3 7.1v5.2h-1.8V7.1Zm-4.8 0v5.2h-1.8V7.1Z"/>' },
  tiktok: { stroke: false, body: '<path d="M16.6 2h-3.3v13.4a2.9 2.9 0 1 1-2-2.8V9.2a6.2 6.2 0 1 0 5.3 6.2V8.7a7.6 7.6 0 0 0 4.4 1.4V6.8a4.4 4.4 0 0 1-4.4-4.4Z"/>' },
  instagram: { stroke: true, body: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>' },
  x: { stroke: false, body: '<path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.9 3h6.3l4.4 5.9Zm-1.1 16.2h1.7L7.4 4.7H5.6Z"/>' },
  discord: { stroke: false, body: '<path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.3a18.4 18.4 0 0 0-5.5 0L8.6 3a19.7 19.7 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18.1a20 20 0 0 0 6 3l1.3-2a13 13 0 0 1-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4a13 13 0 0 1-2 1l1.3 2a20 20 0 0 0 6-3c.5-5.2-.9-9.7-3.6-13.7ZM8 15.4c-1.2 0-2.2-1.1-2.2-2.4S6.8 10.6 8 10.6s2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"/>' },
  steam: { stroke: true, body: '<circle cx="12" cy="12" r="9"/><circle cx="15" cy="10" r="2.5"/><path d="M3.5 14.5l5 2M13 12l-3.5 4"/>' },
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className = 'size-[18px]', label } = Astro.props;
const icon = ICONS[name];
---

<svg
  viewBox="0 0 24 24"
  class:list={['shrink-0', className]}
  fill={icon.stroke ? 'none' : 'currentColor'}
  stroke={icon.stroke ? 'currentColor' : undefined}
  stroke-width={icon.stroke ? 2 : undefined}
  stroke-linecap={icon.stroke ? 'round' : undefined}
  stroke-linejoin={icon.stroke ? 'round' : undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={icon.body}
/>
