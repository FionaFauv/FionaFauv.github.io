---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import VideoThumb from '../components/VideoThumb.astro';
import { LIVE, STREAMS } from '../data/placeholders';
import { formatDate } from '../lib/games';
---

<BaseLayout title="Streams">
  <div class="grid gap-9">
    <PageHeader kicker="Twitch" title="Streams" intro="Mes lives et rediffusions Twitch." />
    <p class="chip justify-self-start">
      <span class:list={['size-3 rounded-full border-2 border-outline', LIVE.isLive ? 'bg-live' : 'bg-muted']} aria-hidden="true"></span>
      {LIVE.isLive ? `En live : ${LIVE.title ?? ''}` : 'Hors ligne · prochain live à définir'}
    </p>
    <ul class="grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-6">
      {
        STREAMS.map((s) => (
          <li class="card p-3">
            <a href={s.url} target="_blank" rel="noopener" class="group grid gap-3 no-underline">
              <VideoThumb src={s.thumbnail} alt="" duration={s.duration} badge="Rediff" />
              <h2 class="px-1 text-xl font-bold text-ink group-hover:text-accent">{s.title}</h2>
              <span class="px-1 pb-1 text-sm font-bold text-muted">{formatDate(s.streamedAt)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
