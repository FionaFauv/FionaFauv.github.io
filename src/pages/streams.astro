---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { LIVE, STREAMS } from '../data/placeholders';
import { formatDate } from '../lib/games';
---

<BaseLayout title="Streams">
  <div class="grid gap-9">
    <PageHeader kicker="Twitch" title="Streams" intro="Planning et rediffusions. Les données Twitch arriveront à l'étape 2." />
    <p class="flex items-center gap-2.5 text-sm">
      <span class:list={['size-[9px] rounded-full', LIVE.isLive ? 'bg-live' : 'bg-muted']} aria-hidden="true"></span>
      {LIVE.isLive ? `En live : ${LIVE.title ?? ''}` : 'Hors ligne · prochain live à définir'}
    </p>
    <ul class="grid grid-cols-[repeat(auto-fill,minmax(230px,1fr))] gap-5">
      {
        STREAMS.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener" class="group grid gap-2 no-underline">
              <div class="placeholder-art relative aspect-video rounded-[10px]">
                <span class="absolute top-1.5 left-1.5 rounded-[5px] bg-live px-1.5 py-1 text-[10px] leading-none font-semibold tracking-wide text-white uppercase">
                  Rediff
                </span>
                <span class="absolute right-1.5 bottom-1.5 rounded-[5px] bg-black/80 px-1.5 py-1 font-mono text-[11px] leading-none text-white">
                  {s.duration}
                </span>
              </div>
              <h2 class="text-lg font-medium group-hover:text-accent">{s.title}</h2>
              <span class="text-[13px] text-muted">{formatDate(s.streamedAt)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
