---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import { SOCIALS } from '../config/site';
---

<BaseLayout title="Mes réseaux" description="Tous les endroits où retrouver FionaFauv.">
  <div class="grid gap-9">
    <PageHeader kicker="Mes réseaux" title="Où me trouver" />
    <ul class="grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-5">
      {
        SOCIALS.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="card flex items-center gap-4 p-4 text-ink no-underline hover:bg-accent-soft"
            >
              <span class="grid size-12 shrink-0 place-items-center rounded-full border-[3px] border-outline bg-bg"><Icon name={s.id} class="size-6" /></span>
              <span>
                <b class="block font-display text-xl leading-tight font-bold">{s.label}</b>
                <span class="text-sm font-semibold text-muted">{s.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
