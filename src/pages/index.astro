---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompletionBar from '../components/CompletionBar.astro';
import DiscordWidget from '../components/DiscordWidget.astro';
import Icon from '../components/Icon.astro';
import Sprout from '../components/Sprout.astro';
import TopList from '../components/TopList.astro';
import VideoThumb from '../components/VideoThumb.astro';
import { SOCIALS } from '../config/site';
import { LIVE } from '../data/placeholders';
import { getDiscord } from '../lib/discord';
import { buildFeed, FEED_KIND } from '../lib/feed';
import { completion, formatDate, formatRating, getGames, recentlyPlayed, topGames } from '../lib/games';
import { sproutStage } from '../lib/sprout';
import { getVideos } from '../lib/youtube';

const games = await getGames();
const videos = await getVideos();
const discord = await getDiscord();
// Les rediffusions Twitch rejoindront le fil avec l'intégration Twitch (Issue #5).
const feed = buildFeed({ videos, streams: [], games });
const firstVideo = feed.find((i) => i.kind === 'video');
const top3 = topGames(games).slice(0, 3);
const lastGame = recentlyPlayed(games)[0];

// Pseudo affiché à côté de chaque réseau : fin de l'URL, sauf pour l'invitation Discord.
const handle = (href: string, id: string) =>
  id === 'discord' ? 'sur invitation' : decodeURIComponent(new URL(href).pathname.split('/').filter(Boolean).pop() ?? '');
const dot = { youtube: 'bg-red', twitch: 'bg-purple', tiktok: 'bg-ink', instagram: 'bg-pink', discord: 'bg-blue', steam: 'bg-blue' } as const;
const badge = {
  red: 'bg-red text-on-color',
  yellow: 'bg-yellow text-on-light',
  purple: 'bg-purple text-on-color',
  white: 'bg-white text-on-light',
} as const;
---

<BaseLayout>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start xl:grid-cols-[minmax(0,1fr)_380px] xl:gap-12">
    <section class="grid gap-7" aria-labelledby="feed-title">
      <h2 id="feed-title" class="kicker flex items-center gap-2.5 text-[15px] text-ink">
        <Icon name="book" class="size-5" />
        Dernières nouvelles
      </h2>

      {feed.length === 0 && <p class="text-muted">Rien de neuf pour l'instant.</p>}

      {
        feed.map((item) => {
          const k = FEED_KIND[item.kind];
          return (
            <article class="card grid gap-4 p-4 sm:p-6">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <span
                  class:list={[
                    'inline-flex items-center gap-1.5 rounded-full border-[3px] border-outline px-3 py-1 font-display text-[15px] leading-none font-bold',
                    badge[k.color],
                  ]}
                >
                  <Icon name={k.icon} class="size-4" />
                  {k.label}
                </span>
                <span class="text-[15px] font-bold text-muted">
                  {item.kind === 'succes' || item.kind === 'avis' ? `${item.game.data.name} · ` : ''}
                  {formatDate(item.date)}
                </span>
              </div>

              {
                item.kind === 'video' &&
                  (item === firstVideo ? (
                    <a href={item.video.url} target="_blank" rel="noopener" class="group grid gap-4 no-underline">
                      <h3 class="text-[26px] font-extrabold text-ink group-hover:text-accent sm:text-[30px]">{item.video.title}</h3>
                      <VideoThumb src={item.video.thumbnail} alt="" duration={item.video.duration} loading="eager" />
                    </a>
                  ) : (
                    <a href={item.video.url} target="_blank" rel="noopener" class="group grid gap-4 no-underline sm:grid-cols-[260px_minmax(0,1fr)] sm:items-center">
                      <VideoThumb src={item.video.thumbnail} alt="" duration={item.video.duration} />
                      <h3 class="text-[22px] font-extrabold text-ink group-hover:text-accent">{item.video.title}</h3>
                    </a>
                  ))
              }

              {
                item.kind === 'live' && (
                  <a href={item.stream.url} target="_blank" rel="noopener" class="group grid gap-4 no-underline sm:grid-cols-[260px_minmax(0,1fr)] sm:items-center">
                    <VideoThumb src={item.stream.thumbnail} alt="" duration={item.stream.duration} badge="Rediff" />
                    <h3 class="text-[22px] font-extrabold text-ink group-hover:text-accent">{item.stream.title}</h3>
                  </a>
                )
              }

              {
                item.kind === 'succes' &&
                  (() => {
                    const a = item.game.data.achievements!;
                    const pct = completion(item.game) ?? 0;
                    return (
                      <>
                        <h3 class="text-[26px] font-extrabold sm:text-[30px]">
                          <a href={`/jeux/${item.game.id}/`} class="text-ink no-underline hover:text-accent">
                            {a.unlocked} succès sur {a.total}
                          </a>
                        </h3>
                        <div class="flex items-center gap-4">
                          <Sprout stage={sproutStage(pct)} color="purple" size={34} />
                          <div class="grid flex-1 gap-2">
                            <CompletionBar unlocked={a.unlocked} total={a.total} showCount={false} />
                            <p class="text-[15px] text-muted">
                              {pct} %{item.game.data.playtimeHours !== undefined && ` · ${item.game.data.playtimeHours} h de jeu`}
                            </p>
                          </div>
                        </div>
                      </>
                    );
                  })()
              }

              {
                item.kind === 'avis' && (
                  <>
                    <h3 class="text-[26px] font-extrabold sm:text-[30px]">
                      {item.game.data.name} : {formatRating(item.game.data.rating)}/10
                    </h3>
                    <div class="flex items-center gap-4">
                      <Sprout stage={sproutStage(completion(item.game) ?? 0)} color="white" size={40} />
                      {item.game.data.review && <p class="text-[17px] leading-relaxed">{item.game.data.review}</p>}
                    </div>
                    <a href={`/jeux/${item.game.id}/`} class="justify-self-start font-extrabold">
                      Lire l'avis complet
                    </a>
                  </>
                )
              }
            </article>
          );
        })
      }
    </section>

    <aside class="grid gap-7 sm:grid-cols-2 lg:sticky lg:top-6 lg:grid-cols-1" aria-label="En bref">
      <section class="card grid content-start gap-3.5 p-5">
        <h2 class="flex items-center gap-2.5 text-[24px] font-extrabold">
          <span class="grid size-10 place-items-center rounded-full border-[3px] border-outline bg-yellow text-on-light">
            <Icon name="sun" class="size-5" />
          </span>
          En ce moment
        </h2>
        <p class="flex items-center gap-2.5 font-extrabold">
          <span class:list={['size-3.5 rounded-full border-2 border-outline', LIVE.isLive ? 'bg-live' : 'bg-muted']} aria-hidden="true"></span>
          Twitch : {LIVE.isLive ? 'en live' : 'hors ligne'}
        </p>
        {
          lastGame && (
            <a href={`/jeux/${lastGame.id}/`} class="flex items-center gap-2.5 font-extrabold text-ink no-underline hover:text-accent">
              <Icon name="gamepad" class="size-[18px] text-purple" />
              Dernier jeu : {lastGame.data.name}
            </a>
          )
        }
      </section>

      <section class="card grid content-start gap-3.5 p-5">
        <h2 class="flex items-center gap-2.5 text-[24px] font-extrabold">
          <span class="grid size-10 place-items-center rounded-full border-[3px] border-outline bg-blue text-on-color">
            <Icon name="chat" class="size-5" />
          </span>
          <a href="/discord/" class="text-ink no-underline hover:text-accent">Discord</a>
        </h2>
        <DiscordWidget data={discord} compact />
      </section>

      {
        top3.length > 0 && (
          <section class="card grid content-start gap-3.5 p-5">
            <h2 class="flex items-center gap-2.5 text-[24px] font-extrabold">
              <span class="grid size-10 place-items-center rounded-full border-[3px] border-outline bg-purple text-on-color">
                <Icon name="star" class="size-5" />
              </span>
              <a href="/jeux/#top" class="text-ink no-underline hover:text-accent">
                Mon top
              </a>
            </h2>
            <TopList games={top3} compact />
          </section>
        )
      }

      <section class="card grid content-start gap-2 p-5">
        <h2 class="mb-1.5 flex items-center gap-2.5 text-[24px] font-extrabold">
          <span class="grid size-10 place-items-center rounded-full border-[3px] border-outline bg-red text-on-color">
            <Icon name="link" class="size-5" />
          </span>
          <a href="/reseaux/" class="text-ink no-underline hover:text-accent">Mes réseaux</a>
        </h2>
        <ul>
          {
            SOCIALS.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center gap-2.5 border-b-2 border-dashed border-line py-2 font-bold text-ink no-underline hover:text-accent"
                >
                  <span class:list={['size-3 shrink-0 rounded-full border-2 border-outline', dot[s.id]]} aria-hidden="true"></span>
                  {s.label}
                  <span class="ml-auto truncate text-muted">{handle(s.href, s.id)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>
